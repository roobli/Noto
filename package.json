{
  "name": "noto",
  "productName": "Noto",
  "version": "0.0.2-alpha.11",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Noto, a Markdown editor that keeps your file byte for byte",
  "author": "lr00rl",
  "homepage": "https://github.com/lr00rl/Noto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lr00rl/Noto.git"
  },
  "bugs": {
    "url": "https://github.com/lr00rl/Noto/issues"
  },
  "main": ".vite/build/main.js",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "compat:node22": "tsc --ignoreConfig --noEmit --strict --target ES2024 --module NodeNext --moduleResolution NodeNext --types node tests/compatibility-probe.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:vite": "vite build --config vite.main.config.mts && vite build --config vite.preload.config.mts && vite build --config vite.service.config.mts && vite build --config vite.plugin-preload.config.mts && vite build --config vite.plugin-runtime.config.mts && vite build --config vite.renderer.config.mts",
    "build": "node scripts/package-variant.mjs release",
    "package:e2e": "node scripts/package-variant.mjs e2e",
    "package:release": "node scripts/package-variant.mjs release",
    "make:release": "node scripts/make-installers.mjs release",
    "verify:package": "node scripts/verify-package.mjs",
    "license:inventory": "node scripts/generate-license-inventory.mjs",
    "license:check": "node scripts/generate-license-inventory.mjs --check",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@roobli/md": "github:roobli/md#v0.1.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-to-markdown-cjk-friendly": "^1.0.0",
    "mermaid": "^11.17.2",
    "micromark-extension-cjk-friendly": "^2.0.1",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "prismjs": "^1.30.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.3",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.0.0",
    "sass": "1.103.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
